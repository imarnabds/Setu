# ==============================================================================
# SETU BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in the values:
#   cp .env.example .env
#
# NEVER commit the actual '.env' file to version control.
# NEVER use EXPO_PUBLIC_* variables for backend secrets.
# ==============================================================================

# Server Runtime Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# Application Name
APP_NAME=Setu

# ==============================================================================
# DATABASE — MongoDB
# ==============================================================================
# MongoDB Atlas: mongodb+srv://<user>:<pass>@<cluster>/<db>?retryWrites=true&w=majority
# Local:         mongodb://127.0.0.1:27017/setu_database
MONGODB_URI=mongodb://127.0.0.1:27017/setu_database

# ==============================================================================
# JWT SECRETS
# Generate: openssl rand -hex 32
# ==============================================================================
# Access token secret (preferred name; JWT_SECRET also accepted for legacy compat)
JWT_ACCESS_SECRET=replace_with_at_least_64_hex_chars_openssl_rand_hex_32

# Access token expiry — keep short. 15m recommended for production.
JWT_EXPIRES_IN=15m

# Refresh token secret — MUST be different from JWT_ACCESS_SECRET
JWT_REFRESH_SECRET=replace_with_a_different_64_hex_string_openssl_rand_hex_32

# Refresh token expiry
REFRESH_TOKEN_EXPIRES_IN=7d

# ==============================================================================
# REDIS — Ephemeral state (OTP challenges, rate limiting, token revocation)
# ==============================================================================
# Redis Cloud free tier: https://redis.com/try-free/  (30 MB free, no credit card)
# Format: redis://<user>:<password>@<host>:<port>
# TLS:    rediss://<user>:<password>@<host>:<port>  (rediss:// enables TLS)
# Leave blank to use in-process fallback (not suitable for production or multi-instance).
REDIS_URL=

# ==============================================================================
# GOOGLE OAUTH 2.0
# ==============================================================================
# 1. Go to https://console.cloud.google.com/  → APIs & Services → Credentials
# 2. Create OAuth 2.0 Client ID  (type: Web application for web, or Android/iOS for mobile)
# 3. Add authorized redirect URIs (e.g., http://localhost:5000/api/auth/google/callback)
# 4. Copy Client ID and Client Secret below.
# The mobile client uses the Client ID to obtain a Google ID token.
# The backend verifies the token server-side — the Client Secret stays here only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ==============================================================================
# OTP SECURITY
# ==============================================================================
# HMAC-SHA256 secret for hashing OTPs before Redis storage.
# Generate: openssl rand -hex 32
# OTPs are NEVER stored in plaintext.
OTP_HMAC_SECRET=replace_with_at_least_32_random_chars_openssl_rand_hex_16

# ==============================================================================
# OTP DELIVERY PROVIDER (Email / SMS)
# ==============================================================================
# Options with free tiers (verify current limits before use):
# - Brevo (formerly Sendinblue): 300 emails/day free. https://app.brevo.com/
# - Mailgun: 1000 emails/month free (US only). https://mailgun.com/
# - Twilio SendGrid: 100 emails/day free. https://sendgrid.com/
# - MSG91 (SMS, India): trial credits available. https://msg91.com/
#
# In development, OTP is printed to server console only (never in API response).
OTP_PROVIDER_API_KEY=
OTP_PROVIDER_SENDER_ID=Setu

# ==============================================================================
# ADMIN BOOTSTRAP
# ==============================================================================
# Set this ONCE before first startup to control the initial admin password.
# After the admin logs in, change the password via the API.
# If unset, a random temporary password is generated and logged at startup.
# Remove or leave blank after the admin account is created.
ADMIN_BOOTSTRAP_PASSWORD=

# ==============================================================================
# CLOUDFLARE (Infrastructure-level — DNS, WAF, proxying)
# ==============================================================================
# 1. Create a free Cloudflare account at https://dash.cloudflare.com/sign-up
# 2. Add your domain and configure DNS records pointing to your backend.
# 3. Enable proxying (orange cloud) to activate WAF and DDoS protection.
# 4. Create an API token: Profile → API Tokens → Create Token (Zone:Read, Zone:Edit)
# Note: Cloudflare protects HTTP traffic at the edge. Backend auth/KYC access
# control is enforced in the application layer independently of Cloudflare.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# ==============================================================================
# CORS
# ==============================================================================
# Comma-separated allowed origins. In production, use only your exact domain(s).
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Primary Frontend URL
FRONTEND_URL=http://localhost:8081

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# ==============================================================================
# UPSTOX IPO INTEGRATION
# ==============================================================================
# Developer Portal: https://upstox.com/developer/api-documentation/
# 1. Register at https://service.upstox.com/developer
# 2. Create an App → obtain Client ID and Secret
# 3. Complete OAuth 2.0 authorization code flow to get a daily Bearer token
# 4. Paste the Bearer token in UPSTOX_ACCESS_TOKEN below.
# When unset or expired, Setu uses offline fallback (retains last sync, marks isStale:true).
UPSTOX_API_BASE_URL=https://api.upstox.com/v2
UPSTOX_ACCESS_TOKEN=

# Frequency of background synchronization in minutes (default: 60)
IPO_SYNC_INTERVAL_MINUTES=60

# Staleness threshold in minutes (default: 120)
IPO_STALE_THRESHOLD_MINUTES=120

# Request timeout for Upstox API calls in milliseconds (default: 10000)
UPSTOX_REQUEST_TIMEOUT_MS=10000


