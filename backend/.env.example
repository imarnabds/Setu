# ==============================================================================
# SETU BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and fill in the values for your deployment environment:
#   cp .env.example .env
#
# DO NOT commit the actual '.env' file containing real secrets to version control!
# ==============================================================================

# Server Runtime Environment (development | production | test)
NODE_ENV=development

# Server Port
PORT=5000

# Application Name
APP_NAME=Setu

# MongoDB Connection String (Atlas or Local Replica Set)
# Format for MongoDB Atlas:
#   mongodb+srv://<username>:<password>@<cluster-url>/<database-name>?retryWrites=true&w=majority
# Format for Local MongoDB:
#   mongodb://127.0.0.1:27017/setu_database
MONGODB_URI=mongodb://127.0.0.1:27017/setu_database

# JWT Signing Secret Key (Must be at least 32 random characters in production)
# Generate a strong key via: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_minimum_32_chars

# Access Token Expiry (e.g., 15m, 1h, 2h)
JWT_EXPIRES_IN=2h

# Refresh Token Secret Key (Must be distinct from JWT_SECRET)
# Generate a strong key via: openssl rand -base64 32
REFRESH_TOKEN_SECRET=replace_with_a_distinct_secure_refresh_secret_32_chars

# Refresh Token Expiry (e.g., 7d, 14d, 30d)
REFRESH_TOKEN_EXPIRES_IN=7d

# CORS Allowed Origins (Comma-separated list or single URL. In production, specify exact client domains)
# Example: http://localhost:8081,http://192.168.1.50:8081,https://app.setu.in
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Primary Frontend Web Application URL
FRONTEND_URL=http://localhost:8081

# Logging Level (debug | info | warn | error)
LOG_LEVEL=info

# ==============================================================================
# UPSTOX IPO INTEGRATION (LIFECYCLE STATUS SYNCHRONIZATION)
# ==============================================================================
# Upstox Developer Portal: https://upstox.com/developer/api-documentation/
# Requirements:
# 1. Register a developer account at https://service.upstox.com/developer
# 2. Create an App to obtain API Key (Client ID) and Secret.
# 3. Complete the OAuth 2.0 authorization code flow to obtain a daily Bearer Access Token.
# 4. Paste the Access Token below. When unset or expired, Setu operates in honest offline
#    fallback mode, retaining the last synchronized MongoDB records and flagging 'isStale: true'.
UPSTOX_API_BASE_URL=https://api.upstox.com/v2
UPSTOX_ACCESS_TOKEN=your_upstox_oauth2_bearer_access_token_here

# Frequency of automatic background synchronization in minutes (default: 60)
IPO_SYNC_INTERVAL_MINUTES=60

# Staleness threshold in minutes after which cached data is tagged as stale (default: 120)
IPO_STALE_THRESHOLD_MINUTES=120

# Request timeout in milliseconds when querying Upstox endpoints (default: 10000)
UPSTOX_REQUEST_TIMEOUT_MS=10000
