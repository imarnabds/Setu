# ==============================================================================
# SETU MOBILE & WEB CLIENT ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# In Expo SDK 49+, variables prefixed with EXPO_PUBLIC_ are automatically bundled
# into the client application code.
#
# DO NOT place database connection strings or backend JWT secrets in this file!
# ==============================================================================

# Application Environment (development | staging | production)
EXPO_PUBLIC_APP_ENV=development

# Backend REST API Base URL
# For Web Browser on same computer: http://localhost:5000/api
# For Physical Android/iOS Device on local WiFi: http://<YOUR_COMPUTER_LAN_IP>:5000/api (e.g. http://192.168.1.100:5000/api)
# For Production: https://api.setu.in/api
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Backend Real-Time WebSocket Server URL
# For Web Browser: http://localhost:5000
# For Physical Device on local WiFi: http://<YOUR_COMPUTER_LAN_IP>:5000
# For Production: https://api.setu.in
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
